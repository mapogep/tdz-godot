; Engine configuration file.
config_version=5

[application]

config/name="Tower Defense: Zombie"
config/description="Кооперативный tower defense с лабиринтом из стен и режимом от первого лица. Порт на Godot 4."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/tex/icon-zombie.png"

[autoload]

I18n="*res://src/autoload/I18n.gd"
Settings="*res://src/autoload/Settings.gd"
Sfx="*res://src/autoload/Sfx.gd"
NetHub="*res://src/autoload/NetHub.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.16, 0.12, 0.1, 1)